{
  "name": "pvme-wikitext",
  "version": "0.1.0",
  "private": true,
  "description": "PvME guide text to RuneScape Wiki wikitext, through @pvme/guide-parser",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pvme-wikitext": "scripts/cli.mjs"
  },
  "exports": {
    ".": "./src/convert.mjs",
    "./resolver": "./src/resolver.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:wiki": "node scripts/check.mjs --wiki"
  },
  "dependencies": {
    "@pvme/guide-parser": "0.4.2",
    "diff": "^9.0.0",
    "node-diff3": "^3.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
